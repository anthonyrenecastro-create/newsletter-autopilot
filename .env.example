# Copy to .env and fill in. Never commit .env.
# Store
SHOPIFY_STORE_DOMAIN=mystore.myshopify.com
SHOPIFY_API_VERSION=2025-10

# From the custom app (API credentials tab). Shown once on install.
SHOPIFY_ADMIN_API_TOKEN=shpat_...

# Blog that receives the free preview editions (numeric ID).
# Find it in the Shopify admin blog URL or via GET /admin/api/2025-10/blogs.json
SHOPIFY_PREVIEW_BLOG_ID=

# Subscribe link used in the preview's call-to-action
PREVIEW_CTA_URL=

# AI provider for the preview writer (wired in src/pipeline/preview.ts)
AI_API_KEY=
AI_MODEL=

# Safety gate: "true" actually publishes; anything else just prints the preview
PREVIEW_AUTO_PUBLISH=false
